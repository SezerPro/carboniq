# Carboniq — Environment variables for production
# Copy this file to .env and fill in the values

# Shopify app credentials (from Partner Dashboard)
SHOPIFY_API_KEY=your_api_key_here
SHOPIFY_API_SECRET=your_api_secret_here
SCOPES=read_products,write_products,write_metaobject_definitions,write_metaobjects

# App URL (your production URL — must be HTTPS)
SHOPIFY_APP_URL=https://your-app.vercel.app

# Database (PostgreSQL — use Supabase, Neon, or Railway)
# For serverless deployments (Vercel), append: ?pgbouncer=true&connection_limit=1
DATABASE_URL=postgresql://user:password@host:5432/carboniq?sslmode=require

# Cron endpoint authentication (any random string, e.g. openssl rand -hex 32)
CRON_SECRET=

# Node environment
NODE_ENV=production
