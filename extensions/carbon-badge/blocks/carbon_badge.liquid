{% comment %}
  Carboniq — Carbon Score Badge
  Fetches the CO₂ score from the app API and displays it as a badge.
{% endcomment %}

<div id="carboniq-badge-{{ product.id }}" class="carboniq-wrapper" style="display:none;">
  <!-- Skeleton loader -->
  <div class="carboniq-skeleton">
    <div class="carboniq-skeleton-bar"></div>
  </div>
</div>

<style>
  .carboniq-wrapper {
    margin: 8px 0;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  }

  /* Skeleton */
  .carboniq-skeleton {
    display: inline-block;
  }
  .carboniq-skeleton-bar {
    width: 140px;
    height: 28px;
    background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%);
    background-size: 200% 100%;
    animation: carboniq-shimmer 1.5s infinite;
    border-radius: 14px;
  }
  @keyframes carboniq-shimmer {
    0% { background-position: 200% 0; }
    100% { background-position: -200% 0; }
  }

  /* ── PILL style ── */
  .carboniq-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 12px;
    border-radius: 999px;
    font-size: 13px;
    font-weight: 600;
    line-height: 1.4;
  }
  .carboniq-pill .carboniq-icon { font-size: 14px; }
  .carboniq-pill .carboniq-score { font-weight: 400; opacity: 0.8; margin-left: 2px; }

  /* ── LEAF style ── */
  .carboniq-leaf {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 14px;
    border-radius: 12px;
    font-size: 13px;
    font-weight: 600;
    border-left: 4px solid;
  }
  .carboniq-leaf .carboniq-icon { font-size: 16px; }

  /* ── MINIMAL style ── */
  .carboniq-minimal {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 12px;
    font-weight: 500;
    opacity: 0.85;
  }
  .carboniq-minimal .carboniq-icon { font-size: 13px; }

  /* ── DETAILED style ── */
  .carboniq-detailed {
    display: inline-flex;
    flex-direction: column;
    gap: 4px;
    padding: 10px 14px;
    border-radius: 10px;
    font-size: 13px;
    border: 1px solid;
  }
  .carboniq-detailed-header {
    display: flex;
    align-items: center;
    gap: 6px;
    font-weight: 700;
    font-size: 14px;
  }
  .carboniq-detailed-score {
    font-size: 12px;
    opacity: 0.7;
  }
  .carboniq-detailed-method {
    font-size: 11px;
    opacity: 0.5;
    margin-top: 2px;
  }
</style>

<script>
  (function() {
    var wrapper = document.getElementById('carboniq-badge-{{ product.id }}');
    if (!wrapper) return;

    var shopDomain = '{{ shop.permanent_domain }}';
    var productId = '{{ product.id }}';
    var badgeStyle = '{{ block.settings.badge_style }}' || 'pill';
    var showMethodology = {{ block.settings.show_methodology | json }};
    // Use Shopify App Proxy — works in both dev and prod
    var proxyUrl = '/apps/carboniq/api/carbon-score';

    // Show wrapper with skeleton
    wrapper.style.display = 'block';

    fetch(proxyUrl + '?shop=' + encodeURIComponent(shopDomain) + '&product_id=' + encodeURIComponent(productId))
      .then(function(res) { return res.json(); })
      .then(function(data) {
        // Silent failure
        if (data.display === 'none' || !data.badge) {
          wrapper.style.display = 'none';
          return;
        }

        var badge = data.badge;
        var score = data.carbonScoreKg;
        var scoreText = score < 1 ? score.toFixed(2) : score.toFixed(1);
        var html = '';

        if (badgeStyle === 'pill') {
          html = '<div class="carboniq-pill" style="color:' + badge.color + ';background:' + badge.bgColor + ';">'
            + '<span class="carboniq-icon">' + badge.icon + '</span>'
            + '<span>' + badge.text + '</span>'
            + '<span class="carboniq-score">' + scoreText + ' kg CO₂</span>'
            + '</div>';
        }
        else if (badgeStyle === 'leaf') {
          html = '<div class="carboniq-leaf" style="color:' + badge.color + ';background:' + badge.bgColor + ';border-left-color:' + badge.color + ';">'
            + '<span class="carboniq-icon">' + badge.icon + '</span>'
            + '<span>' + badge.text + ' — ' + scoreText + ' kg CO₂</span>'
            + '</div>';
        }
        else if (badgeStyle === 'minimal') {
          html = '<div class="carboniq-minimal" style="color:' + badge.color + ';">'
            + '<span class="carboniq-icon">' + badge.icon + '</span>'
            + '<span>' + scoreText + ' kg CO₂</span>'
            + '</div>';
        }
        else if (badgeStyle === 'detailed') {
          html = '<div class="carboniq-detailed" style="color:' + badge.color + ';background:' + badge.bgColor + ';border-color:' + badge.color + ';">'
            + '<div class="carboniq-detailed-header">'
            + '<span class="carboniq-icon">' + badge.icon + '</span>'
            + '<span>' + badge.text + '</span>'
            + '</div>'
            + '<div class="carboniq-detailed-score">' + scoreText + ' kg CO₂ par produit</div>'
            + (showMethodology ? '<div class="carboniq-detailed-method">Estimation basée sur la méthode ADEME / Base Carbone</div>' : '')
            + '</div>';
        }

        wrapper.innerHTML = html;
      })
      .catch(function() {
        // Silent failure — hide the badge
        wrapper.style.display = 'none';
      });
  })();
</script>

{% schema %}
{
  "name": "Carboniq — Score CO₂",
  "target": "section",
  "settings": [
    {
      "type": "select",
      "id": "badge_style",
      "label": "Style du badge",
      "options": [
        { "value": "pill", "label": "Pill" },
        { "value": "leaf", "label": "Leaf" },
        { "value": "minimal", "label": "Minimal" },
        { "value": "detailed", "label": "Détaillé" }
      ],
      "default": "pill"
    },
    {
      "type": "checkbox",
      "id": "show_methodology",
      "label": "Afficher la source méthodologique",
      "default": false
    }
  ]
}
{% endschema %}
